{
  "name": "MiIDE Light",
  "type": "light",
  "colors": {
    "editor.background": "#F5F6FA",
    "editor.foreground": "#1A1C20",
    "editor.selectionBackground": "#1976D233",
    "editorCursor.foreground": "#1976D2",
    "editor.lineHighlightBackground": "#ECEFF5",
    "editorLineNumber.foreground": "#9AA3B2",
    "editorLineNumber.activeForeground": "#1976D2",
    "editorWhitespace.foreground": "#9AA3B2",
    "editorIndentGuide.background": "#D8DCE3",
    "editorIndentGuide.activeBackground": "#1976D2",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.foreground": "#1A1C20",
    "editorSuggestWidget.selectedBackground": "#1976D233",
    "editorSuggestWidget.highlightForeground": "#7C4DFF",
    "editor.findMatchBackground": "#FFB30033",
    "editor.wordHighlightBackground": "#7C4DFF33",
    "editor.wordHighlightStrongBackground": "#7C4DFF4D",
    "highlightedDelimitersForeground": "#00838F"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block", "comment.line", "punctuation.definition.comment"], "settings": { "foreground": "#8A94A8", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "keyword.operator.new", "storage.modifier", "storage.type", "keyword.operator.logical", "keyword.operator.arithmetic", "keyword.operator.bitwise", "keyword.operator.assignment", "keyword.operator.expression"], "settings": { "foreground": "#7C4DFF" } },
    { "scope": ["constant.language", "constant.character.escape", "variable.language", "support.constant", "constant.other"], "settings": { "foreground": "#B26A00" } },
    { "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"], "settings": { "foreground": "#E65100" } },
    { "scope": ["string", "string.quoted.double", "string.quoted.single", "string.quoted.triple", "string.quoted.other", "string.regexp", "punctuation.definition.string.begin", "punctuation.definition.string.end"], "settings": { "foreground": "#2E7D32" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.function", "entity.name.function.decorator"], "settings": { "foreground": "#0277BD" } },
    { "scope": ["variable", "variable.other", "variable.parameter", "variable.assignment", "variable.other.member", "variable.other.property"], "settings": { "foreground": "#1A1C20" } },
    { "scope": ["variable.other.readwrite", "variable.other.constant", "variable.name"], "settings": { "foreground": "#0277BD" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "storage.type.class", "storage.type.interface"], "settings": { "foreground": "#B26A00" } },
    { "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"], "settings": { "foreground": "#C62828" } },
    { "scope": ["entity.other.attribute-name", "attribute.name", "entity.other.attribute-name.id", "entity.other.attribute-name.class"], "settings": { "foreground": "#E65100" } },
    { "scope": ["operator", "punctuation.operator", "keyword.operator.comparison"], "settings": { "foreground": "#00838F" } },
    { "scope": ["punctuation", "punctuation.separator", "punctuation.definition", "punctuation.terminator", "punctuation.bracket", "meta.brace", "punctuation.section"], "settings": { "foreground": "#00838F" } },
    { "scope": ["invalid", "invalid.illegal", "invalid.deprecated"], "settings": { "foreground": "#E53935", "fontStyle": "underline" } },
    { "scope": ["markup.heading", "markup.heading.setext", "punctuation.definition.heading"], "settings": { "foreground": "#0277BD", "fontStyle": "bold" } },
    { "scope": ["markup.bold", "markup.strong"], "settings": { "foreground": "#B26A00", "fontStyle": "bold" } },
    { "scope": ["markup.italic", "markup.emphasis"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.link", "markup.underline.link", "constant.other.reference.link"], "settings": { "foreground": "#0277BD", "fontStyle": "underline" } },
    { "scope": ["markup.quote", "markup.quote.markup"], "settings": { "foreground": "#00838F", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "#2E7D32" } },
    { "scope": ["markup.deleted", "markup.changed", "markup.inserted"], "settings": { "foreground": "#E53935" } },
    { "scope": ["meta.embedded", "source.embedded"], "settings": { "foreground": "#1A1C20" } },
    { "scope": ["meta.annotation", "keyword.other.documentation", "comment.documentation"], "settings": { "foreground": "#7C4DFF", "fontStyle": "italic" } }
  ]
}
