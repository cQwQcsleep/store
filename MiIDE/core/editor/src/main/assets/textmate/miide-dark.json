{
  "name": "MiIDE Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0D1220",
    "editor.foreground": "#E6E9F0",
    "editor.selectionBackground": "#6FB7FF33",
    "editorCursor.foreground": "#6FB7FF",
    "editor.lineHighlightBackground": "#161C2E",
    "editorLineNumber.foreground": "#5A6478",
    "editorLineNumber.activeForeground": "#6FB7FF",
    "editorWhitespace.foreground": "#5A6478",
    "editorIndentGuide.background": "#2A3246",
    "editorIndentGuide.activeBackground": "#6FB7FF",
    "editorSuggestWidget.background": "#161C2E",
    "editorSuggestWidget.foreground": "#E6E9F0",
    "editorSuggestWidget.selectedBackground": "#6FB7FF33",
    "editorSuggestWidget.highlightForeground": "#7C4DFF",
    "editor.findMatchBackground": "#FFB30033",
    "editor.wordHighlightBackground": "#7C4DFF33",
    "editor.wordHighlightStrongBackground": "#7C4DFF4D",
    "highlightedDelimitersForeground": "#89DDFF"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block", "comment.line", "punctuation.definition.comment"], "settings": { "foreground": "#546E7A", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "keyword.operator.new", "storage.modifier", "storage.type", "keyword.operator.logical", "keyword.operator.arithmetic", "keyword.operator.bitwise", "keyword.operator.assignment", "keyword.operator.expression"], "settings": { "foreground": "#C792EA" } },
    { "scope": ["constant.language", "constant.character.escape", "variable.language", "support.constant", "constant.other"], "settings": { "foreground": "#FFCB6B" } },
    { "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"], "settings": { "foreground": "#F78C6C" } },
    { "scope": ["string", "string.quoted.double", "string.quoted.single", "string.quoted.triple", "string.quoted.other", "string.regexp", "punctuation.definition.string.begin", "punctuation.definition.string.end"], "settings": { "foreground": "#C3E88D" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.function", "entity.name.function.decorator"], "settings": { "foreground": "#82AAFF" } },
    { "scope": ["variable", "variable.other", "variable.parameter", "variable.assignment", "variable.other.member", "variable.other.property"], "settings": { "foreground": "#E6E9F0" } },
    { "scope": ["variable.other.readwrite", "variable.other.constant", "variable.name"], "settings": { "foreground": "#82AAFF" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "storage.type.class", "storage.type.interface"], "settings": { "foreground": "#FFCB6B" } },
    { "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"], "settings": { "foreground": "#F07178" } },
    { "scope": ["entity.other.attribute-name", "attribute.name", "entity.other.attribute-name.id", "entity.other.attribute-name.class"], "settings": { "foreground": "#F78C6C" } },
    { "scope": ["operator", "punctuation.operator", "keyword.operator.comparison"], "settings": { "foreground": "#89DDFF" } },
    { "scope": ["punctuation", "punctuation.separator", "punctuation.definition", "punctuation.terminator", "punctuation.bracket", "meta.brace", "punctuation.section"], "settings": { "foreground": "#89DDFF" } },
    { "scope": ["invalid", "invalid.illegal", "invalid.deprecated"], "settings": { "foreground": "#EF5350", "fontStyle": "underline" } },
    { "scope": ["markup.heading", "markup.heading.setext", "punctuation.definition.heading"], "settings": { "foreground": "#82AAFF", "fontStyle": "bold" } },
    { "scope": ["markup.bold", "markup.strong"], "settings": { "foreground": "#FFCB6B", "fontStyle": "bold" } },
    { "scope": ["markup.italic", "markup.emphasis"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.link", "markup.underline.link", "constant.other.reference.link"], "settings": { "foreground": "#82AAFF", "fontStyle": "underline" } },
    { "scope": ["markup.quote", "markup.quote.markup"], "settings": { "foreground": "#89DDFF", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "#C3E88D" } },
    { "scope": ["markup.deleted", "markup.changed", "markup.inserted"], "settings": { "foreground": "#EF5350" } },
    { "scope": ["meta.embedded", "source.embedded"], "settings": { "foreground": "#E6E9F0" } },
    { "scope": ["meta.annotation", "keyword.other.documentation", "comment.documentation"], "settings": { "foreground": "#7C4DFF", "fontStyle": "italic" } }
  ]
}
